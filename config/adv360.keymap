#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        #endif

        dollar_tilde: dollar_tilde {
            compatible = "zmk,behavior-mod-morph";
            label = "dollar_tilde";
            #binding-cells = <0>;
            bindings = <&kp DOLLAR>, <&kp TILDE>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        amper_perc: amper_perc {
            compatible = "zmk,behavior-mod-morph";
            label = "AMPER_PERC";
            #binding-cells = <0>;
            bindings = <&kp AMPERSAND>, <&kp PERCENT>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        exclaimation: exclaimation {
            compatible = "zmk,behavior-mod-morph";
            label = "EXCLAIMATION";
            #binding-cells = <0>;
            bindings = <&kp EXCLAMATION>, <&kp EXCL>;

            mods = <(MOD_LGUI|MOD_RGUI|MOD_RSFT|MOD_LSFT)>;
        };

        left_bracket: left_bracket {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFT_BRACKET";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp LEFT_BRACKET>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        left_brace: left_brace {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFT_BRACE";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE>, <&kp LEFT_BRACE>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        left_parenthesis: left_parenthesis {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFT_PARENTHESIS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LEFT_PARENTHESIS>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        equal: equal {
            compatible = "zmk,behavior-mod-morph";
            label = "EQUAL";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp EQUAL>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        plus: plus {
            compatible = "zmk,behavior-mod-morph";
            label = "PLUS";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&kp PLUS>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        right_parenthesis: right_parenthesis {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHT_PARENTHESIS";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        right_brace: right_brace {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHT_BRACE";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACE>, <&kp RIGHT_BRACE>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        right_bracket: right_bracket {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHT_BRACKET";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACKET>, <&kp RIGHT_BRACKET>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        asterisk: asterisk {
            compatible = "zmk,behavior-mod-morph";
            label = "ASTERISK";
            #binding-cells = <0>;
            bindings = <&kp ASTERISK>, <&kp ASTERISK>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        hash_grave: hash_grave {
            compatible = "zmk,behavior-mod-morph";
            label = "hash_grave";
            #binding-cells = <0>;
            bindings = <&kp HASH>, <&kp GRAVE>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        at_caret: at_caret {
            compatible = "zmk,behavior-mod-morph";
            label = "at_caret";
            #binding-cells = <0>;
            bindings = <&kp AT>, <&kp CARET>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        programmers_dvorak {
            bindings = <
&none           &none      &none      &none           &none           &none  &none                                                    &mo 4          &none  &none           &none           &none  &none  &none
&none           &kp UNDER  &kp COMMA  &kp PERIOD      &kp P           &kp Y  &none                                                    &none          &kp F  &kp G           &kp C           &kp R  &kp L  &none
&kp ESC         &kp A      &kp O      &hm LEFT_ALT E  &hm LEFT_GUI U  &kp I  &none      &none        &none          &none      &none  &none          &kp D  &hm LEFT_GUI H  &hm LEFT_ALT T  &kp N  &kp S  &kp TAB
&kp LEFT_SHIFT  &kp SQT    &kp Q      &kp J           &kp K           &kp X                          &kp LCTRL      &kp RCTRL                        &kp B  &kp M           &kp W           &kp V  &kp Z  &kp RIGHT_SHIFT
&none           &none      &mo 3      &kp LEFT        &kp RIGHT              &kp SPACE  &lt 2 ENTER  &none          &none      &mo 1  &kp BACKSPACE         &kp UP_ARROW    &kp DOWN_ARROW  &mo 4  &none  &none
            >;
        };

        symbol {
            bindings = <
&trans  &trans           &trans         &trans            &trans             &trans         &trans                                      &trans  &trans        &trans                &trans                 &trans         &trans             &trans
&trans  &kp GRAVE        &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS          &kp PIPE       &trans                                      &trans  &kp QUESTION  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOLLAR     &kp BACKSLASH      &trans
&trans  &kp EXCLAMATION  &kp ASTERISK   &kp SLASH         &kp EQUAL          &kp AMPERSAND  &trans  &trans  &trans      &trans  &trans  &trans  &kp POUND     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp DOUBLE_QUOTES  &trans
&trans  &kp TILDE        &kp PLUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PERCENT                    &trans      &trans                  &at_caret     &kp COLON             &kp COMMA              &kp PERIOD     &kp SINGLE_QUOTE   &trans
&trans  &trans           &trans         &trans            &trans                            &trans  &trans  &trans      &trans  &trans  &trans                &trans                &trans                 &trans         &trans             &trans
            >;
        };

        navigation {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans    &trans         &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans    &kp PAGE_UP    &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp HOME  &kp PAGE_DOWN  &kp END  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans    &trans         &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans    &trans         &trans   &trans  &trans
            >;
        };

        keypad {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans        &trans  &trans        &trans        &trans        &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans        &trans  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans        &trans  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                        &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &kp NUMBER_0          &trans        &trans        &kp PERIOD    &trans  &trans
            >;
        };

        mod {
            bindings = <
&none  &none   &none   &none    &none    &none    &none                                               &none            &none  &none         &none         &none        &none                 &none
&none  &kp F1  &kp F2  &kp F3   &kp F4   &none    &none                                               &none            &none  &bt BT_SEL 0  &bt BT_SEL 1  &none        &none                 &none
&none  &kp F5  &kp F6  &kp F7   &kp F8   &none    &none     &none       &none      &none  &none       &none            &none  &kp LEFT_GUI  &kp LEFT_ALT  &none        &rgb_ug RGB_MEFS_CMD  &none
&none  &none   &kp F9  &kp F10  &kp F11  &kp F12                        &none      &none                               &none  &none         &bt BT_SEL 2  &bt BT_SEL 3 &macro_ver            &bootloader
&none  &none   &none   &none    &none    &none              &kp CAPS    &bt BT_CLR &none  &none       &bl BL_TOG       &rgb_ug RGB_TOG      &bl BL_INC    &bl BL_DEC   &none                 &none            
            >;
        };

        fn {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp CAPSLOCK                                      &mo 4   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &to 0                                             &to 8   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &to 7         &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                        &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans        &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        qwerty {
            bindings = <
&kp EQUAL  &kp N1     &kp N2  &kp N3    &kp N4     &kp N5  &trans                                                    &mo 4          &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W   &kp E     &kp R      &kp T   &trans                                                    &trans         &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S   &kp D     &kp F      &kp G   &trans     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &trans         &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X   &kp C     &kp V      &kp B                         &kp HOME      &kp PG_UP                            &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 8      &kp GRAVE  &trans  &kp LEFT  &kp RIGHT          &kp SPACE  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp BACKSPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 8
            >;
        };

        programmers_colemak_dh {
            bindings = <
&trans     &trans         &trans  &trans    &trans     &trans  &trans                                                            &mo 4          &trans  &trans  &trans     &trans      &trans         &trans
&kp TAB    &kp Q          &kp W   &kp F     &kp P      &kp B   &none                                                             &none          &kp J   &kp L   &kp U      &kp Y       &kp SEMICOLON  &kp BSLH
&kp ESC    &kp A          &kp R   &kp S     &kp T      &kp G   &none      &kp LCTRL  &kp LALT      &kp LGUI   &kp RIGHT_CONTROL  &none          &kp M   &kp N   &kp E      &kp I       &kp O          &kp MINUS
&kp LSHFT  &kp Z          &kp X   &kp C     &kp D      &kp V                         &kp HOME      &kp PG_UP                                    &kp K   &kp H   &kp COMMA  &kp PERIOD  &kp APOS       &kp RSHFT
&mo 8      &dollar_tilde  &trans  &kp LEFT  &kp RIGHT          &kp SPACE  &kp DEL    &kp END       &kp PG_DN  &kp ENTER          &kp BACKSPACE          &kp UP  &kp DOWN   &kp SLASH   &at_caret      &mo 8
            >;
        };

        Dvorak_Programmers_RShift {
            bindings = <
&kp PERCENT  &trans        &trans         &trans          &trans     &trans     &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans       &kp LS(SEMI)  &kp LS(COMMA)  &kp LS(PERIOD)  &kp LS(P)  &kp LS(Y)  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans       &kp LS(A)     &kp LS(O)      &kp LS(E)       &kp LS(U)  &kp LS(I)  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans       &kp LS(SQT)   &kp LS(Q)      &kp LS(J)       &kp LS(K)  &kp LS(X)                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans       &kp TILDE     &trans         &trans          &trans                &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        Dvorak_Programmers_LShift {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans     &trans     &trans     &trans        &trans     &kp LS(GRAVE)
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &kp LS(F)  &kp LS(G)  &kp LS(C)  &kp LS(R)     &kp LS(L)  &kp LS(BACKSLASH)
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp LS(D)  &kp LS(H)  &kp LS(T)  &kp LS(N)     &kp LS(S)  &kp LS(MINUS)
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &kp LS(B)  &kp LS(M)  &kp LS(W)  &kp LS(V)     &kp LS(Z)  &trans
&trans  &trans  &mo 10  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans             &trans     &trans     &kp QUESTION  &kp CARET  &trans
            >;
        };

        keypad_shift {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans            &trans  &trans            &trans            &trans            &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans            &trans  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans            &trans  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)  &kp LS(NUMBER_6)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                            &trans  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &kp LS(NUMBER_0)          &trans            &trans            &kp LS(PERIOD)    &trans  &trans
            >;
        };
    };
};
