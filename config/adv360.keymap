#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        #endif

        dollar_tilde: dollar_tilde {
            compatible = "zmk,behavior-mod-morph";
            label = "dollar_tilde";
            #binding-cells = <0>;
            bindings = <&kp DOLLAR>, <&kp TILDE>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        amper_perc: amper_perc {
            compatible = "zmk,behavior-mod-morph";
            label = "AMPER_PERC";
            #binding-cells = <0>;
            bindings = <&kp AMPERSAND>, <&kp PERCENT>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        exclaimation: exclaimation {
            compatible = "zmk,behavior-mod-morph";
            label = "EXCLAIMATION";
            #binding-cells = <0>;
            bindings = <&kp EXCLAMATION>, <&kp EXCL>;

            mods = <(MOD_LGUI|MOD_RGUI|MOD_RSFT|MOD_LSFT)>;
        };

        left_bracket: left_bracket {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFT_BRACKET";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp LEFT_BRACKET>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        left_brace: left_brace {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFT_BRACE";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE>, <&kp LEFT_BRACE>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        left_parenthesis: left_parenthesis {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFT_PARENTHESIS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LEFT_PARENTHESIS>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        equal: equal {
            compatible = "zmk,behavior-mod-morph";
            label = "EQUAL";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp EQUAL>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        plus: plus {
            compatible = "zmk,behavior-mod-morph";
            label = "PLUS";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&kp PLUS>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        right_parenthesis: right_parenthesis {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHT_PARENTHESIS";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        right_brace: right_brace {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHT_BRACE";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACE>, <&kp RIGHT_BRACE>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        right_bracket: right_bracket {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHT_BRACKET";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACKET>, <&kp RIGHT_BRACKET>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        asterisk: asterisk {
            compatible = "zmk,behavior-mod-morph";
            label = "ASTERISK";
            #binding-cells = <0>;
            bindings = <&kp ASTERISK>, <&kp ASTERISK>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        hash_grave: hash_grave {
            compatible = "zmk,behavior-mod-morph";
            label = "hash_grave";
            #binding-cells = <0>;
            bindings = <&kp HASH>, <&kp GRAVE>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        at_caret: at_caret {
            compatible = "zmk,behavior-mod-morph";
            label = "at_caret";
            #binding-cells = <0>;
            bindings = <&kp AT>, <&kp CARET>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        pipe_backslash: pipe_backslash {
            compatible = "zmk,behavior-mod-morph";
            label = "pipe_backslash";
            #binding-cells = <0>;
            bindings = <&kp PIPE>, <&kp BACKSLASH>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <100>;
        };

        hmo: hold_momentary {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_LAYER_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
    };

    combos {
        compatible = "zmk,combos";

        Escape {
            bindings = <&kp ESC>;
            key-positions = <16 17>;
            timeout-ms = <15>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <24 25>;
            timeout-ms = <15>;
        };

        CapsWord {
            bindings = <&kp ENTER>;
            key-positions = <42 43>;
            timeout-ms = <15>;
            layers = <0>;
        };

        CapsWordL {
            bindings = <&caps_word>;
            key-positions = <30 31>;
            timeout-ms = <15>;
            layers = <0>;
        };

        Underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <42 43>;
            timeout-ms = <15>;
            layers = <2>;
        };

        Caret {
            bindings = <&kp CARET>;
            key-positions = <30 31>;
            timeout-ms = <15>;
            layers = <2>;
        };

        Grave {
            bindings = <&kp GRAVE>;
            key-positions = <48 49>;
            timeout-ms = <15>;
            layers = <2>;
        };

        alpha {
            bindings = <&to 0>;
            key-positions = <29 33>;
            layers = <5>;
        };

        gaming {
            bindings = <&to 1>;
            key-positions = <47 51>;
            layers = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        alpha {
            bindings = <
&none  &none           &none     &none             &none           &none  &none                                                         &none          &none  &none           &none             &none     &none           &none
&none  &none           &none     &kp L             &kp P           &kp Y  &none                                                         &none          &kp F  &kp G           &kp C             &kp R     &none           &none
&none  &hm LEFT_ALT A  &hmo 4 O  &hm LEFT_SHIFT E  &hm LEFT_GUI U  &kp I  &none                 &none  &none          &none      &none  &none          &kp D  &hm LEFT_GUI H  &hm LEFT_SHIFT T  &hmo 5 N  &hm LEFT_ALT S  &none
&none  &none           &kp Q     &kp J             &kp K           &kp X                               &kp LCTRL      &kp RCTRL                        &kp B  &kp M           &kp W             &kp V     &kp Z           &none
&none  &none           &none     &none             &none                  &hm LEFT_SHIFT SPACE  &mo 3  &none          &none      &mo 2  &kp BACKSPACE         &none           &none             &none     &none           &none
            >;
        };

        gaming {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                    &trans  &trans  &trans  &trans     &trans      &trans         &trans
&trans  &trans  &kp W   &kp E   &kp R   &kp T   &trans                                                    &trans  &kp Y   &kp U   &kp I      &kp O       &trans         &trans
&trans  &kp A   &kp S   &kp D   &kp F   &kp G   &trans     &trans          &trans         &trans  &trans  &trans  &kp H   &kp J   &kp K      &hmo 5 L    &kp SEMICOLON  &trans
&trans  &kp Z   &kp X   &kp C   &kp V   &kp B                              &kp LCTRL      &trans                  &kp N   &kp M   &kp COMMA  &kp PERIOD  &kp SLASH      &trans
&trans  &trans  &trans  &trans  &trans          &kp SPACE  &kp LEFT_SHIFT  &trans         &trans  &trans  &trans          &trans  &trans     &trans      &trans         &trans
            >;
        };

        symbol {
            bindings = <
&trans  &trans           &trans         &trans            &trans             &trans           &trans                                      &trans  &trans        &trans                &trans                            &trans         &trans             &trans
&trans  &trans           &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS          &pipe_backslash  &trans                                      &trans  &kp QUESTION  &kp LEFT_BRACE        &kp RIGHT_BRACE                   &kp DOLLAR     &trans             &trans
&trans  &kp EXCLAMATION  &kp ASTERISK   &hm LSHIFT SLASH  &kp EQUAL          &kp AMPERSAND    &trans  &trans  &trans      &trans  &trans  &trans  &kp POUND     &kp LEFT_PARENTHESIS  &hm LEFT_SHIFT RIGHT_PARENTHESIS  &kp SEMICOLON  &kp DOUBLE_QUOTES  &trans
&trans  &kp TILDE        &kp PLUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PERCENT                      &trans      &trans                  &kp AT        &kp COLON             &kp COMMA                         &kp PERIOD     &kp SINGLE_QUOTE   &trans
&trans  &trans           &trans         &trans            &trans                              &trans  &trans  &trans      &trans  &trans  &trans                &trans                &trans                            &trans         &trans             &trans
            >;
        };

        nav {
            bindings = <
&trans  &trans        &trans     &trans          &trans        &trans      &trans                                      &trans  &trans    &trans     &trans        &trans         &trans   &trans
&trans  &trans        &trans     &kp LA(F4)      &trans        &trans      &trans                                      &trans  &trans    &kp PG_UP  &kp UP_ARROW  &kp PAGE_DOWN  &trans   &trans
&trans  &kp LEFT_ALT  &trans     &kp LEFT_SHIFT  &kp LEFT_WIN  &trans      &trans  &trans  &trans      &trans  &trans  &trans  &kp HOME  &kp LEFT   &kp DOWN      &kp RIGHT      &kp END  &trans
&trans  &trans        &kp LC(X)  &kp LC(C)       &kp LC(V)     &kp DELETE                  &trans      &trans                  &trans    &trans     &trans        &trans         &trans   &trans
&trans  &trans        &trans     &trans          &trans                    &trans  &trans  &trans      &trans  &trans  &trans            &trans     &trans        &trans         &trans   &trans
            >;
        };

        keypad {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans        &trans        &trans        &trans        &trans        &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans        &kp PLUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans        &kp MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp DOT    &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                        &kp ASTERISK  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &kp NUMBER_0                &trans        &trans        &trans        &trans     &trans
            >;
        };

        mod {
            bindings = <
&none  &none  &none   &none   &none   &none    &none                                                      &none            &none       &none         &none         &none       &none         &none
&none  &none  &kp F7  &kp F8  &kp F9  &kp F10  &none                                                      &none            &bl BL_INC  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_CLR  &none         &none
&none  &none  &kp F4  &kp F5  &kp F6  &kp F11  &none         &none  &none          &none      &none       &none            &bl BL_DEC  &kp LEFT_GUI  &kp LSHIFT    &none       &kp LEFT_ALT  &none
&none  &none  &kp F1  &kp F2  &kp F3  &kp F12                       &kp LCTRL      &kp LCTRL                               &none       &bt BT_SEL 2  &bt BT_SEL 3  &macro_ver  &bootloader   &none
&none  &none  &none   &none   &none            &kp CAPSLOCK  &none  &none          &none      &bl BL_TOG  &rgb_ug RGB_TOG              &none         &none         &none       &none         &none
            >;
        };
    };
};
